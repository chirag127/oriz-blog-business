---
/*
 * LedgerFooter — the ledger "closing balance" strip. Replaces the shared
 * 4-column magazine footer grid.
 *
 * One ruled foot: a double-rule (accounting close), a single mono row of
 * ledger totals (accounts + tags as inline postings), and the carried
 * signature — a "balance carried forward" line. LegalFooter kept for
 * compliance links. Quiet by design; the table above is the loud element.
 */
import LegalFooter from '~/components/chrome/legal/LegalFooter.astro'
import { getCategoriesWithCounts, getTagsWithCounts, slugifyTag } from '~/lib/blog'

const cats = (await getCategoriesWithCounts()).slice(0, 6)
const tags = (await getTagsWithCounts()).slice(0, 8)
const total = cats.reduce((sum, c) => sum + c.count, 0)
---
<footer class="ledger-foot" role="contentinfo">
  <div class="lf-doublerule" aria-hidden="true"><span></span><span></span></div>

  <div class="lf-inner">
    <div class="lf-close">
      <span class="lf-close-k mono">Balance carried forward</span>
      <span class="lf-close-v mono">{total.toString().padStart(3, '0')} entries · book open</span>
    </div>

    <div class="lf-postings">
      <div class="lf-line">
        <span class="lf-line-k mono">Accounts</span>
        <span class="lf-line-v">
          <a href="/categories/">All</a>
          {cats.map((c) => (
            <a href={`/categories/${slugifyTag(c.category)}/`}>{c.category}<span class="lf-ct mono">{c.count}</span></a>
          ))}
        </span>
      </div>
      <div class="lf-line">
        <span class="lf-line-k mono">Tags</span>
        <span class="lf-line-v lf-tags">
          {tags.map((t) => (
            <a href={`/tags/${slugifyTag(t.tag)}/`} class="mono">#{t.tag}</a>
          ))}
        </span>
      </div>
      <div class="lf-line">
        <span class="lf-line-k mono">Ledgers</span>
        <span class="lf-line-v">
          <a href="/series/">Series</a>
          <a href="/archive/">Archive</a>
          <a href="/now/">Now</a>
          <a href="/rss.xml">RSS</a>
        </span>
      </div>
    </div>
  </div>

  <LegalFooter
    github="https://github.com/chirag127/oriz-blog-business"
    appName="The Business Ledger"
    bio="Field notes for founders and freelancers, kept as a double-entry ledger by Chirag Singhal."
    rss="/rss.xml"
  />
</footer>
<style>
  .ledger-foot {
    margin-top: 4rem;
    background: var(--paper-2);
    color: var(--ink);
    border-top: 1px solid var(--rule);
  }
  .lf-doublerule { display: flex; flex-direction: column; gap: 2px; padding-top: 1px; }
  .lf-doublerule span { height: 1px; background: var(--ink); }
  .lf-doublerule span:last-child { background: color-mix(in oklab, var(--accent) 60%, var(--ink)); }

  .lf-inner {
    max-width: 1080px;
    margin-inline: auto;
    padding: 2rem clamp(1rem, 4vw, 2rem) 1.5rem;
    display: grid;
    gap: 1.5rem;
  }

  .lf-close { display: flex; flex-direction: column; gap: 0.25rem; }
  .lf-close-k {
    font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink-mute);
  }
  .lf-close-v {
    font-size: 15px; letter-spacing: 0.02em; color: var(--ink); font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .lf-postings { display: grid; gap: 0.75rem; }
  .lf-line {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 0.75rem;
    align-items: baseline;
    padding-block: 0.5rem;
    border-top: 1px solid color-mix(in oklab, var(--rule) 70%, transparent);
  }
  .lf-line-k {
    font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-mute);
  }
  .lf-line-v { display: flex; flex-wrap: wrap; gap: 0.35rem 1rem; align-items: baseline; }
  .lf-line-v a {
    color: var(--ink); text-decoration: none; font-size: 14px;
    display: inline-flex; align-items: baseline; gap: 0.35rem;
  }
  .lf-line-v a:hover { color: var(--accent); }
  .lf-ct { font-size: 10px; color: var(--ink-mute); font-variant-numeric: tabular-nums; }
  .lf-tags a { font-size: 13px; color: var(--ink-mute); }
  .lf-tags a:hover { color: var(--accent); }

  @media (min-width: 768px) {
    .lf-inner { grid-template-columns: 1fr; }
  }
</style>
