---
import SeriesSpine from '~/components/SeriesSpine.astro'
/**
 * /  — The Business Ledger front page.
 *
 * ARCHETYPE: double-entry ledger. Above: a ledger header (folio dateline,
 * thesis nameplate, sum-rule signature, one open-account spine). Below: a
 * single ruled LEDGER TABLE — every post is a posted entry in columns
 *   FOLIO | ENTRY (title + dek) | ACCOUNT | POSTED | FOLIOS
 * with a <thead>, tabular-num dates, zebra ruled rows, and a per-account
 * posting-mark tick. No cards, no radius, no cover images. The table IS the
 * page. A short "open accounts" (in-progress series) strip sits above it.
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import {
  getCategoriesWithCounts,
  getPostsInSeries,
  getPublishedPosts,
  getSeriesWithCounts,
  postVertical,
  readingTimeFor,
  slugifyTag,
  verticalLabel,
} from '~/lib/blog'
import { SITE_CONFIG } from '~/lib/config'

const allPosts = await getPublishedPosts()
const lead = allPosts[0]
// full ledger table: lead + everything else, most-recent first
const entries = allPosts

const seriesAll = await getSeriesWithCounts()
type InProgress = {
  name: string
  slug: string
  total: number
  published: number
  current: number
  latest: Date
}
const inProgress: InProgress[] = []
for (const { series, count } of seriesAll.slice(0, 4)) {
  const parts = await getPostsInSeries(series)
  const latest = parts.reduce(
    (max, p) => (p.data.pubDate > max ? p.data.pubDate : max),
    parts[0].data.pubDate,
  )
  const explicitMax = parts.reduce((mx, p) => {
    const v = typeof p.data.part === 'number' ? p.data.part : Number(p.data.part)
    return Number.isFinite(v) ? Math.max(mx, v) : mx
  }, 0)
  const total = Math.max(count, explicitMax, count + 1)
  inProgress.push({
    name: series,
    slug: slugifyTag(series),
    total,
    published: count,
    current: count,
    latest,
  })
}
inProgress.sort((a, b) => b.latest.valueOf() - a.latest.valueOf())

const cats = await getCategoriesWithCounts()

const now = new Date()
const dateline = now.toLocaleDateString('en-GB', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})
const fy = now.getFullYear()

// folio number: newest entry = highest folio, counting down.
const startFolio = entries.length

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE_CONFIG.title,
  url: `${SITE_CONFIG.url}/`,
  description: SITE_CONFIG.description,
  author: { '@type': 'Person', name: SITE_CONFIG.author.name, url: SITE_CONFIG.author.url },
}
---

<BaseLayout
  title="The Business Ledger"
  description={SITE_CONFIG.description}
  jsonLd={jsonLd}
>
  <div class="ledger-page">
    {/* ── Ledger header (masthead) ─────────────────────────────────── */}
    <section class="masthead" aria-label="Ledger header">
      <div class="dateline mono">
        <span class="dateline-vol">The Business Ledger</span>
        <span class="dateline-sep" aria-hidden="true">·</span>
        <span class="dateline-date">FY{fy} · {dateline}</span>
        <span class="dateline-sep" aria-hidden="true">·</span>
        <span class="dateline-count"><span class="count">{entries.length}</span> entries posted</span>
      </div>
      <h1 class="nameplate">Build the business, not the deck.</h1>
      <div class="sum-rule" aria-hidden="true"></div>
      <p class="nameplate-sub">Field notes for founders and freelancers — validating ideas cheaply, pricing your work, and landing the first ten customers. Every entry earns its line in the book.</p>
      {inProgress[0] && (
        <p class="masthead-spine">
          <span class="masthead-spine-label mono">Open account</span>
          <SeriesSpine
            total={inProgress[0].total}
            published={inProgress[0].published}
            current={inProgress[0].current}
            size="md"
          />
          <a class="masthead-spine-name" href={`/series/${inProgress[0].slug}/`}>{inProgress[0].name}</a>
        </p>
      )}
    </section>

    {/* ── Open accounts (in-progress series) ───────────────────────── */}
    {inProgress.length > 0 && (
      <section class="accounts" aria-labelledby="s-accounts">
        <h2 id="s-accounts" class="section-h mono">Open accounts</h2>
        <ul class="accounts-list">
          {inProgress.map((s) => (
            <li class="accounts-row">
              <a class="accounts-link" href={`/series/${s.slug}/`}>
                <span class="accounts-name">{s.name}</span>
                <SeriesSpine total={s.total} published={s.published} current={s.current} size="sm" />
                <span class="accounts-meta mono">part {s.published} / {s.total}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* ── THE LEDGER TABLE ─────────────────────────────────────────── */}
    <section class="ledger" aria-labelledby="s-ledger">
      <h2 id="s-ledger" class="section-h mono">General ledger</h2>
      <div class="ledger-scroll">
        <table class="ledger-table">
          <caption class="sr-only">All published entries, most recent first</caption>
          <thead>
            <tr>
              <th scope="col" class="col-folio mono">Folio</th>
              <th scope="col" class="col-entry mono">Entry</th>
              <th scope="col" class="col-account mono">Account</th>
              <th scope="col" class="col-posted mono">Posted</th>
              <th scope="col" class="col-folios mono">Length</th>
            </tr>
          </thead>
          <tbody>
            {entries.map((p, i) => {
              const v = postVertical(p)
              const folio = (startFolio - i).toString().padStart(3, '0')
              const rt = p.data.readingTime ?? readingTimeFor(p)
              return (
                <tr class="ledger-row" data-vertical={v} data-lead={i === 0 ? 'true' : undefined}>
                  <td class="col-folio mono" data-label="Folio">{folio}</td>
                  <td class="col-entry" data-label="Entry">
                    <a class="entry-link" href={`/blog/${p.id}`}>
                      <span class="entry-title">{p.data.title}{i === 0 && <span class="entry-flag mono">latest</span>}</span>
                      <span class="entry-dek">{p.data.description}</span>
                    </a>
                  </td>
                  <td class="col-account" data-label="Account">
                    <span class="account-mark" aria-hidden="true"></span>
                    <span class="account-name mono">{verticalLabel(v)}</span>
                  </td>
                  <td class="col-posted mono" data-label="Posted">
                    <time datetime={p.data.pubDate.toISOString()}>{p.data.pubDate.toISOString().slice(0, 10)}</time>
                  </td>
                  <td class="col-folios mono" data-label="Length">{rt}</td>
                </tr>
              )
            })}
          </tbody>
        </table>
      </div>
      <p class="ledger-foot-row mono">
        <span class="lfr-rule" aria-hidden="true"></span>
        <a href="/archive/">Full archive · {entries.length} entries →</a>
      </p>
    </section>

    {/* ── Chart of accounts (categories, one ruled row) ────────────── */}
    {cats.length > 0 && (
      <section class="chart" aria-labelledby="s-chart">
        <h2 id="s-chart" class="section-h mono">Chart of accounts</h2>
        <ul class="chart-list">
          {cats.map((c) => (
            <li class="chart-row">
              <a href={`/categories/${slugifyTag(c.category)}/`} class="chart-link">
                <span class="chart-name">{c.category}</span>
                <span class="chart-dots" aria-hidden="true"></span>
                <span class="chart-count mono">{c.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .ledger-page {
    max-width: 1080px;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2rem);
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  /* ── Masthead ─────────────────────────────────────────────────────── */
  .masthead { padding-block: clamp(1.75rem, 5vw, 3rem) 1.25rem; }
  .dateline {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem;
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-mute);
    padding-bottom: 0.875rem; border-bottom: 1px solid var(--rule); margin-bottom: 1.5rem;
  }
  .dateline-vol { color: var(--accent); font-weight: 500; }
  .dateline-sep { color: var(--rule-strong, var(--rule)); }
  .dateline .count { color: var(--ink); }
  .nameplate {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(2.5rem, 8vw, 4.75rem);
    font-weight: 600; letter-spacing: -0.025em; line-height: 0.98;
    color: var(--ink); margin: 0; max-width: 15ch;
  }
  /* SIGNATURE — ledger sum-rule: ink line + accent underscore ("total"). */
  .sum-rule {
    margin: 1.1rem 0 0; max-width: 15ch;
    border-top: 1px solid var(--ink); height: 4px;
    box-shadow: 0 3px 0 -1px var(--accent);
  }
  .nameplate-sub {
    font-family: var(--font-body);
    font-size: clamp(1.0625rem, 2vw, 1.25rem); line-height: 1.5;
    color: var(--ink-mute); margin: 1.25rem 0 0; max-width: 54ch;
  }
  .masthead-spine {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.625rem; margin: 1.5rem 0 0;
  }
  .masthead-spine-label {
    font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-mute);
  }
  .masthead-spine-name {
    font-family: var(--font-display); font-size: 1rem; font-weight: 500; color: var(--ink);
    text-decoration: none; border-bottom: 1px solid var(--rule);
  }
  .masthead-spine-name:hover { color: var(--accent); border-bottom-color: var(--accent); }

  /* ── Section heading ──────────────────────────────────────────────── */
  .section-h {
    font-family: var(--font-mono); font-size: 11px; text-transform: uppercase;
    letter-spacing: 0.18em; color: var(--ink-mute); font-weight: 500; margin: 0 0 0.75rem;
  }

  /* ── Open accounts ────────────────────────────────────────────────── */
  .accounts { padding-block: 1.5rem 0.5rem; }
  .accounts-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; }
  .accounts-row { border-top: 1px solid color-mix(in oklab, var(--rule) 70%, transparent); }
  .accounts-row:last-child { border-bottom: 1px solid color-mix(in oklab, var(--rule) 70%, transparent); }
  .accounts-link {
    display: flex; align-items: center; gap: 0.875rem; flex-wrap: wrap;
    padding-block: 0.625rem; color: var(--ink); text-decoration: none;
  }
  .accounts-link:hover { color: var(--accent); }
  .accounts-name { font-family: var(--font-display); font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; }
  .accounts-meta { font-size: 11px; letter-spacing: 0.06em; color: var(--ink-mute); font-variant-numeric: tabular-nums; margin-left: auto; }
  .accounts-link:hover .accounts-meta { color: var(--accent); }

  /* ── The ledger table ─────────────────────────────────────────────── */
  .ledger { padding-block: 1.75rem 0.5rem; }
  .ledger-scroll { overflow-x: auto; }
  .ledger-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
    /* the ruled book: heavy top + bottom, hairline between rows */
    border-top: 3px solid var(--ink);
  }
  .ledger-table thead th {
    text-align: left;
    font-family: var(--font-mono);
    font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase;
    font-weight: 500; color: var(--ink-mute);
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--ink);
    white-space: nowrap;
    background: var(--paper-2);
  }
  .col-folio { width: 62px; }
  .col-account { width: 168px; }
  .col-posted { width: 118px; }
  .col-folios { width: 74px; text-align: right; }
  .ledger-table thead .col-folios { text-align: right; }

  .ledger-row {
    --v: var(--v-personal);
    border-bottom: 1px solid color-mix(in oklab, var(--rule) 75%, transparent);
    transition: background var(--dur-fast, 120ms) ease;
  }
  .ledger-row[data-vertical='dev'] { --v: var(--v-dev); }
  .ledger-row[data-vertical='finance'] { --v: var(--v-finance); }
  .ledger-row[data-vertical='culture'] { --v: var(--v-culture); }
  .ledger-row[data-vertical='health'] { --v: var(--v-health); }
  /* zebra ruling — alternate manila tint */
  .ledger-row:nth-child(even) { background: color-mix(in oklab, var(--paper-2) 45%, transparent); }
  .ledger-row:hover { background: color-mix(in oklab, var(--accent) 7%, transparent); }
  .ledger-row[data-lead='true'] { background: color-mix(in oklab, var(--accent) 5%, transparent); }

  .ledger-table td { padding: 0.75rem; vertical-align: baseline; }

  .col-folio {
    color: var(--ink-mute); font-size: 12px; font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    border-right: 1px solid color-mix(in oklab, var(--rule) 60%, transparent);
  }
  /* posting-mark tick in the folio gutter, per account colour */
  .ledger-row td.col-folio { position: relative; }
  .ledger-row td.col-folio::before {
    content: ''; position: absolute; left: 0; top: 0.9rem;
    width: 3px; height: 0.9em; background: var(--v);
  }

  .entry-link { display: grid; gap: 0.15rem; color: var(--ink); text-decoration: none; }
  .entry-title {
    font-family: var(--font-display); font-size: 1.0625rem; font-weight: 600;
    letter-spacing: -0.01em; line-height: 1.25;
    display: inline-flex; align-items: baseline; gap: 0.5rem; flex-wrap: wrap;
  }
  .entry-flag {
    font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--accent); border: 1px solid color-mix(in oklab, var(--accent) 45%, transparent);
    padding: 1px 5px; transform: translateY(-1px);
  }
  .entry-link:hover .entry-title { color: var(--accent); }
  .entry-dek {
    font-family: var(--font-body); font-size: 13.5px; color: var(--ink-mute); line-height: 1.45;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 1; line-clamp: 1; overflow: hidden;
  }

  .col-account { color: var(--v); }
  .account-mark { display: inline-block; width: 7px; height: 7px; background: var(--v); margin-right: 0.4rem; transform: translateY(-1px); }
  .account-name { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--v); font-weight: 500; }

  .col-posted { color: var(--ink-mute); font-size: 12px; letter-spacing: 0.03em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .col-folios { color: var(--ink-mute); font-size: 11px; text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }

  .ledger-foot-row {
    display: flex; align-items: center; gap: 1rem; margin: 1rem 0 0; font-size: 12px;
  }
  .lfr-rule { flex: 1; height: 0; border-top: 1px solid var(--ink); }
  .ledger-foot-row a {
    color: var(--ink-mute); letter-spacing: 0.06em; text-transform: uppercase;
    text-decoration: none; white-space: nowrap;
  }
  .ledger-foot-row a:hover { color: var(--accent); }

  /* ── Chart of accounts ────────────────────────────────────────────── */
  .chart { padding-block: 2rem 1rem; }
  .chart-list { list-style: none; padding: 0; margin: 0; }
  .chart-row { border-bottom: 1px solid color-mix(in oklab, var(--rule) 65%, transparent); }
  .chart-row:first-child { border-top: 1px solid color-mix(in oklab, var(--rule) 65%, transparent); }
  .chart-link {
    display: flex; align-items: baseline; gap: 0.5rem; padding-block: 0.55rem;
    color: var(--ink); text-decoration: none;
  }
  .chart-name { font-family: var(--font-display); font-size: 1rem; font-weight: 500; letter-spacing: -0.01em; }
  .chart-link:hover .chart-name { color: var(--accent); }
  .chart-dots { flex: 1; border-bottom: 1px dotted var(--rule-strong, var(--rule)); transform: translateY(-3px); }
  .chart-count { font-size: 12px; color: var(--ink-mute); font-variant-numeric: tabular-nums; }

  /* ── Mobile: table → stacked posting slips ────────────────────────── */
  @media (max-width: 719px) {
    .ledger-table, .ledger-table tbody, .ledger-table tr, .ledger-table td { display: block; width: 100%; }
    .ledger-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .ledger-scroll { overflow-x: visible; }
    .ledger-table { border-top: 3px solid var(--ink); }
    .ledger-row {
      padding: 0.875rem 0.75rem 0.875rem 1.25rem;
      position: relative;
      border-bottom: 1px solid var(--rule);
    }
    .ledger-row::before {
      content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--v);
    }
    .ledger-table td { padding: 0.1rem 0; border: 0 !important; }
    .ledger-table td.col-folio::before { display: none; }
    .col-folio { display: inline-block; width: auto; margin-right: 0.6rem; }
    .col-folio::after { content: ' ·'; color: var(--rule-strong, var(--rule)); }
    .col-account { display: inline-block; }
    /* row meta line: folio + account inline, then title, dek, posted+length */
    .col-posted, .col-folios {
      display: inline-block; width: auto; text-align: left;
    }
    .col-folios::before { content: ' · '; color: var(--rule-strong, var(--rule)); }
    .entry-dek { -webkit-line-clamp: 2; line-clamp: 2; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ledger-row { transition: none; }
  }
</style>
